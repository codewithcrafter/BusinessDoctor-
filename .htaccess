# ============================================================
# BusinessDoctor Production Apache / LiteSpeed Configuration
# Optimized for Hostinger & Shared Web Hosting
# ============================================================

# 1. Disable Directory Browsing
Options -Indexes -MultiViews +FollowSymLinks
DirectoryIndex index.php index.html

# 2. Character Encoding
AddDefaultCharset UTF-8
AddType text/markdown .md

# 3. URL Rewriting & HTTPS Enforcement
<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase /

    # Force HTTPS in production
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(127\.0\.0\.1|localhost)(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct web access to sensitive internal directories
    RewriteRule ^(database|scratch|includes)/ - [F,L,NC]

    # 301 Redirect legacy /service-detail.php?slug={slug} to clean /{slug}-company-in-delhi
    RewriteCond %{THE_REQUEST} \s/+service-detail(?:\.php)?\?slug=([a-zA-Z0-9_-]+) [NC]
    RewriteRule ^ /%1-company-in-delhi? [R=301,L]

    # 301 Redirect legacy /service-detail.php without slug to /company-in-delhi
    RewriteCond %{THE_REQUEST} \s/+service-detail(?:\.php)?(\s|\?) [NC]
    RewriteRule ^ /company-in-delhi? [R=301,L]

    # 301 Redirect legacy /insight-detail.php?slug={slug} to clean /blog/{slug}
    RewriteCond %{THE_REQUEST} \s/+insight-detail(?:\.php)?\?slug=([a-zA-Z0-9_-]+) [NC]
    RewriteRule ^ /blog/%1? [R=301,L]

    # 301 Redirect legacy /insight-detail.php without slug to /blog
    RewriteCond %{THE_REQUEST} \s/+insight-detail(?:\.php)?(\s|\?) [NC]
    RewriteRule ^ /blog? [R=301,L]

    # 301 Redirect legacy /services.php and /insights.php
    RewriteCond %{THE_REQUEST} \s/+services\.php(\s|\?) [NC]
    RewriteRule ^ /company-in-delhi? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+insights\.php(\s|\?) [NC]
    RewriteRule ^ /blog? [R=301,L]

    # ============================================================
    # Universal Markdown Document Routes (*.md & /md gateway)
    # Handled BEFORE HTML/PHP rewrites and custom 404 handlers
    # ============================================================

    # 1. Clean Markdown Gateway: /md or /md/
    RewriteRule ^md/?$ markdown-router.php [L,QSA]
    RewriteRule ^sitemap\.xml$ markdown-router.php [L,QSA]
    RewriteRule ^llms\.txt$ markdown-router.php [L,QSA]

    # Direct static serving for static .php.md endpoints when physical file exists in /md/
    RewriteCond %{DOCUMENT_ROOT}/md/$1.md -f
    RewriteRule ^([a-zA-Z0-9_-]+)\.php\.md$ md/$1.md [L]

    # 2. Universal Markdown Routing:
    # Matches any request ending in .md (e.g. /.md, /about.php.md, /services/foo.md, /insight-detail.php.md)
    # or targeting the central /md/... repository
    RewriteCond %{REQUEST_URI} !^/markdown-router\.php
    RewriteRule (\.md$|^md/|^llms\.txt$|^sitemap\.xml$) markdown-router.php [L,QSA]

    # 301 Redirect legacy service aliases to canonical -company-in-delhi
    RewriteRule ^(?:services|company)/web-software-development/?$ /web-development-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company)/ai-automation-workflows/?$ /web-development-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company)/brand-creative-direction/?$ /graphic-design-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company)/digital-marketing-seo/?$ /seo-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company)/ui-ux-branding/?$ /graphic-design-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company)/ecommerce-marketplaces/?$ /ecommerce-management-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company)/creative-video-production/?$ /video-editing-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company)/cloud-it-consulting/?$ /web-development-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company)/seo-services/?$ /seo-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company)/smo-services/?$ /smo-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company)/digital-marketing/?$ /social-media-marketing-company-in-delhi [R=301,L]

    # 301 Redirect old /services/{slug} and /company/{slug} to new /{slug}-company-in-delhi structure
    RewriteRule ^(?:services|company)/([a-zA-Z0-9_-]+)/?$ /$1-company-in-delhi [R=301,L]

    # 301 Redirect old services overview paths to /company-in-delhi
    RewriteRule ^(?:services|company)/?$ /company-in-delhi [R=301,L]

    # 301 Redirect old /insights/{slug} to /blog/{slug}
    RewriteRule ^insights/([a-zA-Z0-9_-]+)/?$ /blog/$1 [R=301,L]

    # 301 Redirect old /insights to /blog
    RewriteRule ^insights/?$ /blog [R=301,L]

    # Clean Services Overview Rewriting: /company-in-delhi -> services.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^company-in-delhi/?$ services.php [L,QSA]

    # Clean Service URL Rewriting: /{slug}-company-in-delhi -> service-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-zA-Z0-9_-]+)-company-in-delhi/?$ service-detail.php?slug=$1 [L,QSA]

    # Clean Blog Listing Rewriting: /blog -> insights.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/?$ insights.php [L,QSA]

    # Clean Blog Detail Rewriting: /blog/{slug} -> insight-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ insight-detail.php?slug=$1 [L,QSA]

    # Clean Case Study URLs: /case-studies/{slug} -> case-study-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^case-studies/([a-zA-Z0-9_-]+)/?$ case-study-detail.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^case-studies/?$ case-studies.php [L,QSA]

    # Clean Admin Gateway Rewriting: /admin -> admin/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^admin/?$ admin/index.php [L,QSA]



</IfModule>

# 4. Strict File Access Controls
<FilesMatch "^\.(env|git|sqlite|sql|log)">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sqlite|sqlite3|db|sql|env|ini|log|bak|lock)$">
    Require all denied
</FilesMatch>

# 5. Security Response Headers
<IfModule mod_headers.c>
    <FilesMatch "\.md$">
        Header set Content-Type "text/markdown; charset=UTF-8"
        Header set Access-Control-Allow-Origin "*"
        Header set X-Robots-Tag "index, follow"
    </FilesMatch>
    <FilesMatch "^(sitemap\.xml|llms\.txt|llms\.md|robots\.txt)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

</IfModule>

# 6. GZIP / Brotli Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml

</IfModule>

# 7. Browser Static Asset Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"

    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

</IfModule>

