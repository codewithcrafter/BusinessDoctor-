# ============================================================
# BusinessDoctor Production Apache / LiteSpeed Configuration
# Optimized for Hostinger & Shared Web Hosting
# ============================================================

# 1. Disable Directory Browsing
Options -Indexes -MultiViews +FollowSymLinks
DirectoryIndex index.php index.html

# 2. Character Encoding
AddDefaultCharset UTF-8
AddType text/markdown .md

# 3. URL Rewriting & HTTPS Enforcement
<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase /

    # Force HTTPS in production
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(127\.0\.0\.1|localhost)(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct web access to sensitive internal directories
    RewriteRule ^(database|scratch|includes)/ - [F,L,NC]

    # 301 Redirect public .php requests to clean URLs
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s\?] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+(about|contact|audit|diagnostic|case-studies|services)\.php[\s\?] [NC]
    RewriteRule ^(about|contact|audit|diagnostic|case-studies|services)\.php$ /$1 [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+(insights|blog)\.php[\s\?] [NC]
    RewriteRule ^(insights|blog)\.php$ /blog [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+service-detail(?:\.php)?\?slug=([a-zA-Z0-9_-]+) [NC]
    RewriteRule ^ /service/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+service-detail(?:\.php)?(\s|\?) [NC]
    RewriteRule ^ /services? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+insight-detail(?:\.php)?\?slug=([a-zA-Z0-9_-]+) [NC]
    RewriteRule ^ /blog/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+insight-detail(?:\.php)?(\s|\?) [NC]
    RewriteRule ^ /blog? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+case-study-detail(?:\.php)?\?slug=([a-zA-Z0-9_-]+) [NC]
    RewriteRule ^ /case-studies/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+case-study-detail(?:\.php)?(\s|\?) [NC]
    RewriteRule ^ /case-studies? [R=301,L]

    # ============================================================
    # Universal Markdown Document Routes (*.md & /md gateway)
    # Handled BEFORE HTML/PHP rewrites and custom 404 handlers
    # ============================================================

    # Block retired markdown files (/home.md, /md/home.md, /llms.md, /.md)
    RewriteRule ^(?:home\.md|md/home\.md|llms\.md|\.md|index\.md|md/index\.md)$ - [R=404,L]

    # 1. Clean Markdown Gateway: /md or /md/
    RewriteRule ^md/?$ markdown-router.php [L,QSA]
    RewriteRule ^sitemap\.xml$ markdown-router.php [L,QSA]
    RewriteRule ^llms\.txt$ markdown-router.php [L,QSA]

    # Direct static serving for static .php.md endpoints when physical file exists in /md/
    RewriteCond %{DOCUMENT_ROOT}/md/$1.md -f
    RewriteRule ^([a-zA-Z0-9_-]+)\.php\.md$ md/$1.md [L]

    # 2. Universal Markdown Routing:
    RewriteCond %{REQUEST_URI} !^/markdown-router\.php
    RewriteRule (\.md$|^md/|^llms\.txt$|^sitemap\.xml$) markdown-router.php [L,QSA]

    # 301 Redirect legacy service aliases to canonical root URLs
    RewriteRule ^(?:services|company|service)/ppc(?:-paid-ads)?/?$ /ppc-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/smo(?:-services)?/?$ /smo-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/google-business-profile(?:-management)?/?$ /google-business-profile-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/ecommerce-(?:management|marketplaces|acceleration)/?$ /ecommerce-management-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/graphic-design/?$ /graphic-design-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/(?:ui-ux-branding|brand-architecture|brand-creative-direction)/?$ /graphic-design-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/seo(?:-services)?/?$ /seo-services-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/digital-marketing(?:-seo)?/?$ /seo-services-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/social-media-marketing/?$ /social-media-marketing-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/product-photography/?$ /product-photography-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/(?:video-editing|creative-video-production|creative-production)/?$ /video-editing-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/(?:web-development|web-software-development|strategic-consulting|digital-engineering|ai-automation-workflows)/?$ /web-development-company-in-delhi [R=301,L]
    RewriteRule ^(?:services|company|service)/cloud-it-consulting/?$ /web-development-company-in-delhi [R=301,L]

    # 301 Redirect old SEO company variant to seo-services-in-delhi
    RewriteRule ^seo-company-in-delhi/?$ /seo-services-in-delhi [R=301,L]

    # 301 Redirect old services overview paths to canonical /services
    RewriteRule ^digital-marketing-company-in-delhi/?$ /services [R=301,L]
    RewriteRule ^(?:company-in-delhi|company)/?$ /services [R=301,L]

    # 301 Redirect old /insights/{slug} to /blog/{slug}
    RewriteRule ^insights/([a-zA-Z0-9_-]+)/?$ /blog/$1 [R=301,L]

    # 301 Redirect old /insights to /blog
    RewriteRule ^insights/?$ /blog [R=301,L]

    # Clean Canonical Service URL Rewriting
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^seo-services-in-delhi/?$ service-detail.php?slug=seo [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-zA-Z0-9_-]+)-company-in-delhi/?$ service-detail.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-zA-Z0-9_-]+)-services-in-delhi/?$ service-detail.php?slug=$1 [L,QSA]

    # Clean Services Overview Rewriting: /services -> services.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^services/?$ services.php [L,QSA]

    # Clean Blog Listing Rewriting: /blog -> insights.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/?$ insights.php [L,QSA]

    # Clean Blog Detail Rewriting: /blog/{slug} -> insight-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ insight-detail.php?slug=$1 [L,QSA]

    # Clean Case Study URLs: /case-studies/{slug} -> case-study-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^case-studies/([a-zA-Z0-9_-]+)/?$ case-study-detail.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^case-studies/?$ case-studies.php [L,QSA]

    # Clean Core Pages: /about, /contact, /audit
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^about/?$ about.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^contact/?$ contact.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^audit/?$ audit.php [L,QSA]

    # Clean Admin Gateway Rewriting: /admin -> admin/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^admin/?$ admin/index.php [L,QSA]



</IfModule>

# 4. Strict File Access Controls
<FilesMatch "^\.(env|git|sqlite|sql|log)">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sqlite|sqlite3|db|sql|env|ini|log|bak|lock)$">
    Require all denied
</FilesMatch>

# 5. Security Response Headers
<IfModule mod_headers.c>
    <FilesMatch "\.md$">
        Header set Content-Type "text/markdown; charset=UTF-8"
        Header set Access-Control-Allow-Origin "*"
        Header set X-Robots-Tag "index, follow"
    </FilesMatch>
    <FilesMatch "^(sitemap\.xml|llms\.txt|llms\.md|robots\.txt)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

</IfModule>

# 6. GZIP / Brotli Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml

</IfModule>

# 7. Browser Static Asset Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"

    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

</IfModule>

