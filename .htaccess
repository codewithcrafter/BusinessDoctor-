# ============================================================
# BusinessDoctor Production Apache / LiteSpeed Configuration
# Optimized for Hostinger & Shared Web Hosting
# ============================================================

# 1. Disable Directory Browsing & Trailing Slash Redirects
Options -Indexes
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

# 2. Character Encoding
AddDefaultCharset UTF-8

# 3. URL Rewriting & HTTPS Enforcement
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS in production
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(127\.0\.0\.1|localhost)(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct web access to sensitive internal directories
    RewriteRule ^(database|scratch|includes)/ - [F,L,NC]

    # Clean Admin URL Rewriting: /admin -> admin/index.php (Login & Dashboard unified controller)
    RewriteRule ^admin/?$ admin/index.php [L,QSA]

    # 301 Redirect legacy /service-detail.php?slug={slug} to clean /services/{slug}
    RewriteCond %{THE_REQUEST} \s/+service-detail(?:\.php)?\?slug=([a-zA-Z0-9_-]+) [NC]
    RewriteRule ^ /services/%1? [R=301,L]

    # 301 Redirect legacy /service-detail.php without slug to /services.php
    RewriteCond %{THE_REQUEST} \s/+service-detail(?:\.php)?(\s|\?) [NC]
    RewriteRule ^ /services.php? [R=301,L]

    # Clean Service URL Rewriting: /services/{slug} -> /service-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^services/([a-zA-Z0-9_-]+)/?$ service-detail.php?slug=$1 [L,QSA]

    # Clean Services Index Rewriting: /services -> /services.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^services/?$ services.php [L,QSA]

    # 301 Redirect legacy /case-study-detail.php?slug={slug} to clean /case-studies/{slug}
    RewriteCond %{THE_REQUEST} \s/+case-study-detail(?:\.php)?\?slug=([a-zA-Z0-9_-]+) [NC]
    RewriteRule ^ /case-studies/%1? [R=301,L]

    # 301 Redirect legacy /case-study-detail.php without slug to /case-studies.php
    RewriteCond %{THE_REQUEST} \s/+case-study-detail(?:\.php)?(\s|\?) [NC]
    RewriteRule ^ /case-studies.php? [R=301,L]

    # Clean Case Study URL Rewriting: /case-studies/{slug} -> /case-study-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^case-studies/([a-zA-Z0-9_-]+)/?$ case-study-detail.php?slug=$1 [L,QSA]

    # Clean Case Studies Index Rewriting: /case-studies -> /case-studies.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^case-studies/?$ case-studies.php [L,QSA]

    # 301 Redirect legacy /insight-detail.php?slug={slug} to clean /insights/{slug}
    RewriteCond %{THE_REQUEST} \s/+insight-detail(?:\.php)?\?slug=([a-zA-Z0-9_-]+) [NC]
    RewriteRule ^ /insights/%1? [R=301,L]

    # 301 Redirect legacy /blog-detail.php?slug={slug} to clean /insights/{slug}
    RewriteCond %{THE_REQUEST} \s/+blog-detail(?:\.php)?\?slug=([a-zA-Z0-9_-]+) [NC]
    RewriteRule ^ /insights/%1? [R=301,L]

    # 301 Redirect legacy /insight-detail.php & /blog-detail.php without slug to /insights.php
    RewriteCond %{THE_REQUEST} \s/+(insight-detail|blog-detail)(?:\.php)?(\s|\?) [NC]
    RewriteRule ^ /insights.php? [R=301,L]

    # Clean Insights URL Rewriting: /insights/{slug} -> /insight-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^insights/([a-zA-Z0-9_-]+)/?$ insight-detail.php?slug=$1 [L,QSA]

    # Alias Clean Blogs URL: /blogs/{slug} -> /insight-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blogs/([a-zA-Z0-9_-]+)/?$ insight-detail.php?slug=$1 [L,QSA]

    # Clean Insights Index Rewriting: /insights -> /insights.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^insights/?$ insights.php [L,QSA]

    # Clean Blogs Index Rewriting: /blogs -> /insights.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blogs/?$ insights.php [L,QSA]

    # Clean Markdown Representation Rewriting
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^blogs/([a-zA-Z0-9_-]+)\.md$ content-md/blogs/$1.md [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^insights/([a-zA-Z0-9_-]+)\.md$ content-md/blogs/$1.md [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^case-studies/([a-zA-Z0-9_-]+)\.md$ content-md/case-studies/$1.md [L]
</IfModule>

# Markdown & Plain Text MIME Configuration
<IfModule mod_mime.c>
    AddType text/markdown .md
    AddType text/plain .txt
    AddType application/xml .xml
</IfModule>

<FilesMatch "\.md$">
    <IfModule mod_headers.c>
        Header set Content-Type "text/markdown; charset=utf-8"
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>

<FilesMatch "^(llms|llms-full)\.txt$">
    <IfModule mod_headers.c>
        Header set Content-Type "text/plain; charset=utf-8"
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>

# 4. Strict File Access Controls
<FilesMatch "^\.(env|git|sqlite|sql|log)">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sqlite|sqlite3|db|sql|env|ini|log|bak|lock)$">
    Require all denied
</FilesMatch>

# 5. Security Response Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# 6. GZIP / Brotli Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 7. Browser Static Asset Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

