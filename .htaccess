# ============================================================
# BusinessDoctor Production Apache / LiteSpeed Configuration
# Optimized for Hostinger & Shared Web Hosting
# ============================================================

# 1. Disable Directory Browsing
Options -Indexes -MultiViews +FollowSymLinks
DirectoryIndex index.php index.html

# 2. Character Encoding
AddDefaultCharset UTF-8
AddType text/markdown .md

# 3. URL Rewriting & HTTPS Enforcement
<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase /

    # Force HTTPS in production
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(127\.0\.0\.1|localhost)(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct web access to sensitive internal directories
    RewriteRule ^(database|scratch|includes)/ - [F,L,NC]

    # 301 Redirect legacy /service-detail.php?slug={slug} to clean /company/{slug}
    RewriteCond %{THE_REQUEST} \s/+service-detail(?:\.php)?\?slug=([a-zA-Z0-9_-]+) [NC]
    RewriteRule ^ /company/%1? [R=301,L]

    # 301 Redirect legacy /service-detail.php without slug to /services.php
    RewriteCond %{THE_REQUEST} \s/+service-detail(?:\.php)?(\s|\?) [NC]
    RewriteRule ^ /services.php? [R=301,L]

    # ============================================================
    # Universal Markdown Document Routes (*.md & /md gateway)
    # Handled BEFORE HTML/PHP rewrites and custom 404 handlers
    # ============================================================

    # 1. Clean Markdown Gateway: /md or /md/
    RewriteRule ^md/?$ markdown-router.php [L,QSA]

    # Direct static serving for static .php.md endpoints when physical file exists in /md/
    RewriteCond %{DOCUMENT_ROOT}/md/$1.md -f
    RewriteRule ^([a-zA-Z0-9_-]+)\.php\.md$ md/$1.md [L]

    # 2. Universal Markdown Routing:
    # Matches any request ending in .md (e.g. /.md, /about.php.md, /services/foo.md, /insight-detail.php.md)
    # or targeting the central /md/... repository
    RewriteCond %{REQUEST_URI} !^/markdown-router\.php
    RewriteRule (\.md$|^md/) markdown-router.php [L,QSA]

    # 301 Redirect legacy service slugs to new service slugs under /company/
    RewriteRule ^(?:services|company)/web-software-development/?$ /company/web-development [R=301,L]
    RewriteRule ^(?:services|company)/digital-marketing-seo/?$ /company/seo [R=301,L]
    RewriteRule ^(?:services|company)/ui-ux-branding/?$ /company/graphic-design [R=301,L]
    RewriteRule ^(?:services|company)/ecommerce-marketplaces/?$ /company/ecommerce-management [R=301,L]
    RewriteRule ^(?:services|company)/creative-video-production/?$ /company/video-editing [R=301,L]
    RewriteRule ^(?:services|company)/cloud-it-consulting/?$ /company/web-development [R=301,L]

    # 301 Redirect all old /services/{slug} to new /company/{slug} structure
    RewriteRule ^services/([a-zA-Z0-9_-]+)/?$ /company/$1 [R=301,L]

    # 301 Redirect all old /services/{slug}.md to new /company/{slug}.md
    RewriteRule ^services/([a-zA-Z0-9_-]+)\.md$ /company/$1.md [R=301,L]

    # Clean Service URL Rewriting: /company/{slug} -> service-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^company/([a-zA-Z0-9_-]+)/?$ service-detail.php?slug=$1 [L,QSA]

    # Clean Services Index Rewriting: /services -> /services.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^services/?$ services.php [L,QSA]

    # Clean Insight URLs: /insights/{slug} -> insight-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^insights/([a-zA-Z0-9_-]+)/?$ insight-detail.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^insights/?$ insights.php [L,QSA]

    # Clean Case Study URLs: /case-studies/{slug} -> case-study-detail.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^case-studies/([a-zA-Z0-9_-]+)/?$ case-study-detail.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^case-studies/?$ case-studies.php [L,QSA]

    # Clean Admin Gateway Rewriting: /admin -> admin/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^admin/?$ admin/index.php [L,QSA]



</IfModule>

# 4. Strict File Access Controls
<FilesMatch "^\.(env|git|sqlite|sql|log)">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sqlite|sqlite3|db|sql|env|ini|log|bak|lock)$">
    Require all denied
</FilesMatch>

# 5. Security Response Headers
<IfModule mod_headers.c>
    <FilesMatch "\.md$">
        Header set Content-Type "text/markdown; charset=UTF-8"
        Header set Access-Control-Allow-Origin "*"
        Header set X-Robots-Tag "index, follow"
    </FilesMatch>
    <FilesMatch "^(sitemap\.xml|llms\.txt|llms\.md|robots\.txt)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

</IfModule>

# 6. GZIP / Brotli Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml

</IfModule>

# 7. Browser Static Asset Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"

    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

</IfModule>

