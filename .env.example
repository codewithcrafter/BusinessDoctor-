# ============================================================
# BusinessDoctor Environment Configuration Template
# Configure for https://demo.businessdoctor.com
# ============================================================

# Environment: 'production' or 'development'
# In production, error display is disabled and errors are logged to protected files
APP_ENV=production

# Public URL of the website
APP_URL=https://demo.businessdoctor.com

# Database Driver: 'sqlite' (active for demo deployment) or 'mysql'
DB_DRIVER=sqlite

# SQLite Configuration (Relative to project root or absolute path)
DB_SQLITE_PATH=database/businessdoctor.sqlite

# MySQL Database Connection Details (Dormant until MySQL migration)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u123456789_businessdoctor
DB_USER=u123456789_bduser
DB_PASS=YourStrongProductionPassword123!
DB_CHARSET=utf8mb4
